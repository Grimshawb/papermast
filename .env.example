SITE_ADDRESS=:80

MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
JWT_KEY=replace-with-at-least-32-random-bytes

GOOGLE_BOOKS_API_KEY=replace-with-a-server-side-api-key
NYT_KEY=replace-with-the-nyt-api-key
WIKI_REQUEST_HEADER=PaperMast/1.0 (your-email@example.com)
OPEN_LIBRARY_USER_AGENT=PaperMast/1.0 (your-email@example.com)

# The AI librarian is staged independently from its public API switch. Start
# its private infrastructure first, restore and verify the catalog, and only
# then set LIBRARIAN_ENABLED=true.
LIBRARIAN_INFRA_ENABLED=false
LIBRARIAN_ENABLED=false
LIBRARIAN_COLLECTION=papermast_fiction_bge_runtime_v1
LIBRARIAN_CATALOG_VERSION=bge-runtime-v1
LIBRARIAN_EXPECTED_POINTS=676258
LIBRARIAN_GEMINI_MODEL=gemini-3.5-flash-lite
LIBRARIAN_MAX_CONCURRENCY=2
LIBRARIAN_REQUEST_TIMEOUT_SECONDS=20
LIBRARIAN_CACHE_MINUTES=60
GEMINI_API_KEY=replace-with-the-gemini-api-key
QDRANT_API_KEY=replace-with-a-long-random-api-key

# CI sets these to immutable GHCR commit tags in production.
PAPERMAST_WEB_IMAGE=papermast-web:local
PAPERMAST_API_IMAGE=papermast-api:local
PAPERMAST_LIBRARIAN_IMAGE=papermast-librarian:local
