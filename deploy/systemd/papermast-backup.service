[Unit]
Description=Create and verify a PaperMast MySQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/papermast-backup scheduled
ExecStartPost=/usr/local/sbin/papermast-backup-upload

# A dump should not prevent shutdown indefinitely if Docker or MySQL hangs.
TimeoutStartSec=30min
